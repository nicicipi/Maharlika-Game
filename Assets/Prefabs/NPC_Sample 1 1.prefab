--- !u!114 &8714750893319820589
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3531638988668802163}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb36200979016d44e95cfa4a765ce9d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  triggerOnEnter: 1
  dialogue:
    dialogueLines:
    - character:
        name: ???
        icon: {fileID: 21300000, guid: c886c5c023c8918428700d1409b7adf6, type: 3}
      line: RB-02, what's the status over there?
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: RB-02
        icon: {fileID: 21300000, guid: 5e651398769878449b7a70c7aade6494, type: 3}
      line: Good so far, Boss. We're almost done with Operation Red Grass!
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: ???
        icon: {fileID: 21300000, guid: c886c5c023c8918428700d1409b7adf6, type: 3}
      line: Keep up the good work. Finally, this land will be mine.
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: Lyka
        icon: {fileID: 21300000, guid: 9a38fb5b7381f5d499bcee62d2d03e8b, type: 3}
      line: (What are they talking about?)
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: RB-02
        icon: {fileID: 21300000, guid: 5e651398769878449b7a70c7aade6494, type: 3}
      line: Are there tasks left you'd like to remind, Boss? Before I disconnect?
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: ???
        icon: {fileID: 21300000, guid: c886c5c023c8918428700d1409b7adf6, type: 3}
      line: Make sure...
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: ???
        icon: {fileID: 21300000, guid: c886c5c023c8918428700d1409b7adf6, type: 3}
      line: To burn everything into crisps!
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: Lyka
        icon: {fileID: 21300000, guid: 990c6f90ab95c7c4d85cb7881e550219, type: 3}
      line: (What?! How could he say that?!)
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: RB-02
        icon: {fileID: 21300000, guid: 5e651398769878449b7a70c7aade6494, type: 3}
      line: If we do, should we evacuate the residents?
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: ???
        icon: {fileID: 21300000, guid: c886c5c023c8918428700d1409b7adf6, type: 3}
      line: HAHAHA... Funny robot
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: ???
        icon: {fileID: 21300000, guid: c886c5c023c8918428700d1409b7adf6, type: 3}
      line: I couldn't care less about the residents, burn them as well!
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: Lyka
        icon: {fileID: 21300000, guid: 990c6f90ab95c7c4d85cb7881e550219, type: 3}
      line: Hey clanker!
      onLineStarted:
        m_PersistentCalls:
          m_Calls:
          - m_Target: {fileID: 2968849010343016926}
            m_TargetAssemblyTypeName: EnemyNoticeEffect, Assembly-CSharp
            m_MethodName: ShowNotice
            m_Mode: 1
            m_Arguments:
              m_ObjectArgument: {fileID: 0}
              m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
              m_IntArgument: 0
              m_FloatArgument: 0
              m_StringArgument: 
              m_BoolArgument: 0
            m_CallState: 2
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: RB-02
        icon: {fileID: 21300000, guid: 5e651398769878449b7a70c7aade6494, type: 3}
      line: Who goes here?!
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: Lyka
        icon: {fileID: 21300000, guid: 990c6f90ab95c7c4d85cb7881e550219, type: 3}
      line: I won't let you destroy the legacy our ancestors worked so hard for over
        some petty cash!
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: ???
        icon: {fileID: 21300000, guid: c886c5c023c8918428700d1409b7adf6, type: 3}
      line: RB-02, it's just a brat, get her!
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
    - character:
        name: Lyka
        icon: {fileID: 21300000, guid: 990c6f90ab95c7c4d85cb7881e550219, type: 3}
      line: I'll destroy you!
      onLineStarted:
        m_PersistentCalls:
          m_Calls: []
      textEffect: 0
      effectStrength: 1
      effectSpeed: 5
      useCustomTypingSpeed: 0
      typingSpeed: 0.03
